// Copy to config.h (git-ignored) and fill in. NEVER commit real credentials or private keys.
// Every tunable below is optional: omitted ones fall back to the defaults in aquaguard_core.h.
#pragma once

// ---- Wi-Fi (2.4 GHz) ------------------------------------------------------------------
#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// ---- MQTT over TLS (port 8883). See docs/hardware/mqtt-tls-setup.md ----------------------
#define MQTT_HOST       "broker.example.local"
#define MQTT_PORT       8883
// Per-device broker account (from `python -m app.cli provision-sensor`, being added by the
// backend work; or infra/mosquitto/device_password.sh <society>/<unit>). Username form: "<society>/<unit>".
#define MQTT_USER       "demo/101"
#define MQTT_PASSWORD   "CHANGE_ME"
// PEM of the CA that signed the broker certificate (public data, not a secret).
// (a variable, not a #define: raw strings cannot span preprocessor lines)
static const char MQTT_CA_CERT_PEM[] = R"EOF(-----BEGIN CERTIFICATE-----
CHANGE_ME
-----END CERTIFICATE-----
)EOF";
// DEV ONLY: skip certificate verification. Logs a loud warning on every connect. Never in production.
// #define ALLOW_INSECURE_DEV

// ---- identity: topic aquaguard/<society>/<unit>/..., client id aquaguard-<society>-<unit> ----
#define SOCIETY_SLUG    "demo"
#define FLAT_UNIT       "101"

// ---- pins (see docs/hardware/wiring-and-electrical.md; 3.3 V logic ONLY) -------------------
#define FLOW_PIN        27          // YF-S201 signal AFTER level shifting/divider
#define VALVE_RELAY_PIN 26          // relay module IN (not a strapping pin)
#define RELAY_ACTIVE_LOW 0          // 1 if the relay board energises on a LOW input. CHECK YOUR BOARD.
#define BATTERY_ADC_PIN 34          // input-only ADC1 pin; set -1 if no battery divider (bat/vbat => null)

