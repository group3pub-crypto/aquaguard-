# Runtime configuration (read by the Next.js server on every request; the same Docker image
# works behind any domain). Set these on the container / process environment.
# Base URL of the AquaGuard backend (REST is served under /api/v1)
AQUAGUARD_API_URL=http://localhost:8000
# WebSocket base URL (live feed at /api/v1/ws/live). Defaults to AQUAGUARD_API_URL with ws(s)://
# AQUAGUARD_WS_URL=ws://localhost:8000
# IANA timezone of the BACKEND (its TIMEZONE setting). Baseline chart slots are hour-of-week,
# Monday=0, in this timezone. Must match the backend or the baseline band is shifted.
AQUAGUARD_BACKEND_TZ=UTC

# For `npm run dev` the NEXT_PUBLIC_* names are also accepted as fallbacks:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000
# NEXT_PUBLIC_BACKEND_TZ=UTC
