{
  "name": "aquaguard-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "snapshot:openapi": "cd ../backend && ENVIRONMENT=test python -c \"from app.main import app_factory; import json; print(json.dumps(app_factory().openapi()))\" > ../dashboard/src/lib/openapi.snapshot.json"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.17.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
