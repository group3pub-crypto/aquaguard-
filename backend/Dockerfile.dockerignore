# Used by `docker build -f backend/Dockerfile .` (context = repo root). Allow-list only what the
# image needs; patterns are relative to the repo root.
*
!backend
!libs/aquaguard_features
**/__pycache__
**/*.pyc
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.env
**/.env.*
backend/tests
backend/scripts
