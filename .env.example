# AquaGuard configuration. Copy to .env (or run `make env`, which fills secrets
# with fresh random values). NEVER commit .env.
# Generate a secret manually with:  openssl rand -hex 32
# Values equal to CHANGE_ME are rejected by the backend in production.

# --- General -----------------------------------------------------------------
ENVIRONMENT=development            # development | production | test
BACKEND_LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Secrets (>= 32 chars for SECRET_KEY; production refuses to start otherwise)
SECRET_KEY=CHANGE_ME

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=aquaguard
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aquaguard
# Used when running the backend outside compose; compose builds its own URL.
DATABASE_URL=postgresql+asyncpg://aquaguard:CHANGE_ME@localhost:5432/aquaguard

# --- MQTT (mosquitto password file is generated at container start) ----------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=aquaguard
MQTT_PASSWORD=CHANGE_ME
# Readings stamped further in the future are rejected. The demo simulator runs at --speed 60
# (ahead of wall clock), so the demo needs a large value; keep 300 in production.
MQTT_MAX_FUTURE_SKEW_S=86400
# Per-device broker accounts (see infra/mosquitto/README.md). Leave MQTT_DEVICES empty to run
# without device accounts (the demo simulator then uses the backend account).
MQTT_DEVICES=
MQTT_DEVICE_SECRET=
MQTT_CONTROL_USERNAME=
MQTT_CONTROL_PASSWORD=

# --- Demo --------------------------------------------------------------------
DEMO_MODE=true                     # true | false. Keep false in production.
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_RESIDENT_PASSWORD=CHANGE_ME

# --- ML ----------------------------------------------------------------------
MODEL_DIR=/app/ml/models

# --- Dashboard (inlined at build time) ----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Optional: IBM watsonx ---------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# --- Telegram bot (profile `bot`) --------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user ids that are bot admins.
TELEGRAM_ADMIN_IDS=
# Backend service account used by the bot (create it with admin/maintenance role).
BOT_API_USERNAME=bot_service
BOT_API_PASSWORD=CHANGE_ME
