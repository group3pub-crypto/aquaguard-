# AquaGuard configuration (production defaults). `make env` copies this to .env, replaces every
# CHANGE_ME with a fresh random value (openssl) and never overwrites an existing .env.
# NEVER commit .env. `make check-env` validates the result; docs/deployment.md explains every
# variable. Defaults shown for optional variables are the ones the code/compose use.
#
# Which placeholders are rejected, and by whom:
#   SECRET_KEY            backend (production): CHANGE_ME and other placeholders, < 32 chars,
#                         < 16 distinct characters
#   DB_APP_PASSWORD       backend (production): weak/placeholder passwords inside DATABASE_URL
#   MQTT_PASSWORD         mosquitto entrypoint: CHANGE_ME*, < 12 chars
#   TELEGRAM_BOT_TOKEN, BOT_API_PASSWORD   bot: empty or CHANGE_ME*
#   POSTGRES_PASSWORD, DB_OWNER_PASSWORD, DB_BACKUP_PASSWORD, DB_APP_PASSWORD
#                         infra/postgres/10-roles.sh at first database initialisation: CHANGE_ME*,
#                         < 16 chars, characters outside [A-Za-z0-9_.~-]
#   everything above, METRICS_TOKEN and MQTT_DEVICE_SECRET   `make check-env` (run by `make up`)
# Anything else is NOT validated by the code: do not rely on it being rejected.

# --- Public endpoint ----------------------------------------------------------
# Host name served by the TLS proxy. CORS origins and the dashboard's API/WebSocket URLs are
# derived from it (https://PUBLIC_DOMAIN, wss://PUBLIC_DOMAIN).
PUBLIC_DOMAIN=aquaguard.example.com
# "internal" = Caddy's private CA (LAN/testing), or an e-mail address = ACME (Let's Encrypt)
CADDY_TLS=internal
# Interface the proxy (80/443) and the MQTT TLS listener (8883) bind on the host
PUBLIC_BIND_ADDR=0.0.0.0
# IANA time zone of the deployment (backend TIMEZONE and dashboard AQUAGUARD_BACKEND_TZ)
TIMEZONE=UTC

# --- Backend ------------------------------------------------------------------
SECRET_KEY=CHANGE_ME
LOG_LEVEL=INFO
# access token lifetime, minutes (1-1440)
ACCESS_TOKEN_MINUTES=15
ALLOW_SELF_REGISTRATION=false
# OpenAPI docs (/docs); off in production
ENABLE_DOCS=false
# Prometheus /metrics (bearer METRICS_TOKEN, >= 24 chars); see docker-compose.monitoring.yml
METRICS_ENABLED=false
METRICS_TOKEN=CHANGE_ME
# memory:// is per process; use redis://... if you run more than one worker
RATE_LIMIT_STORAGE_URI=memory://
# Proxy addresses whose X-Forwarded-* headers are trusted; never "*". Must equal the proxy's
# address on the `app` network (172.31.250.2, fixed in docker-compose.yml / .prod.yml)
FORWARDED_ALLOW_IPS=172.31.250.2
# data retention in days (0 = keep forever)
READINGS_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=0
# valve safety timings, seconds
SHUTOFF_WARNING_SECONDS=300
VALVE_ACK_TIMEOUT_S=60

# --- PostgreSQL (roles are created on first initialisation, infra/postgres/init.sql) ---------
# Passwords must stay URL-safe: [A-Za-z0-9_.~-]
# bootstrap superuser aquaguard_admin (restores/break-glass only)
POSTGRES_PASSWORD=CHANGE_ME
# aquaguard_owner: owns the schema, used only by the one-shot migration service
DB_OWNER_PASSWORD=CHANGE_ME
# aquaguard_app: the backend's runtime role (DML only)
DB_APP_PASSWORD=CHANGE_ME
# aquaguard_backup: read-only role for the backup container
DB_BACKUP_PASSWORD=CHANGE_ME

# --- MQTT ---------------------------------------------------------------------
MQTT_USERNAME=aquaguard
MQTT_PASSWORD=CHANGE_ME
# Per-device broker accounts "<society-slug>/<unit>" (comma/space separated). See
# infra/mosquitto/README.md and `make provision-sensor`. Restart mosquitto after changing.
MQTT_DEVICES=
# >= 32 chars; required when MQTT_DEVICES is non-empty. Rotating it rotates every device password.
MQTT_DEVICE_SECRET=CHANGE_ME
# TLS listener for devices (8883). Paths are INSIDE the mosquitto container. Production with
# Caddy-issued ACME certificates (set <domain> = PUBLIC_DOMAIN):
#   MQTT_TLS_CERT_FILE=/caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/<domain>/<domain>.crt
#   MQTT_TLS_KEY_FILE=/caddy-data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/<domain>/<domain>.key
# Private CA / LAN: put server.crt, server.key (and ca.crt) in MQTT_TLS_DIR and use
#   MQTT_TLS_CERT_FILE=/mosquitto/certs/server.crt  MQTT_TLS_KEY_FILE=/mosquitto/certs/server.key
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=
MQTT_TLS_CA_FILE=
# host directory mounted read-only at /mosquitto/certs (default ./.dev-certs, git-ignored)
MQTT_TLS_DIR=./.dev-certs
# development only (docker-compose.dev.yml): read-only client for simulator fault injection
MQTT_CONTROL_USERNAME=
MQTT_CONTROL_PASSWORD=

# --- Optional LLM text (data leaves the host; off by default) ---------------------------------
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# backend limit: <= 4 seconds
LLM_TIMEOUT_S=4
# calls per UTC day (0 = none)
LLM_DAILY_BUDGET=500

# --- Telegram bot (compose profile `bot`: COMPOSE_PROFILES=bot) ------------------------------
TELEGRAM_BOT_TOKEN=
# comma-separated numeric Telegram user ids that are bot admins
TELEGRAM_ADMIN_IDS=
# backend account the bot logs in with (create it first; role maintenance or admin)
BOT_API_USERNAME=bot_service
BOT_API_PASSWORD=CHANGE_ME
# natural-language mode (uses ANTHROPIC_API_KEY / LLM_MODEL above)
BOT_NLU_ENABLED=false
# bot-side LLM timeout (seconds, <= 60); separate from LLM_TIMEOUT_S, which the backend caps at 4
BOT_LLM_TIMEOUT_S=15

# --- Backups (compose profile `backup`) ----------------------------------------------------
# PUBLIC age key ("age1..."): `age-keygen -o key.txt` and keep key.txt OFFLINE, never on this host
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
# the daily run starts at HH:17 UTC
BACKUP_HOUR_UTC=2

# --- Image pins (optional) -----------------------------------------------------------------
# Override with a digest after `make pin-digests`, e.g. POSTGRES_IMAGE=postgres:16.6-bookworm@sha256:...
# POSTGRES_IMAGE=postgres:16.6-bookworm
# MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.20
# CADDY_IMAGE=caddy:2.10.0-alpine
# TIMESCALE_IMAGE=timescale/timescaledb:2.17.2-pg16
# PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
# ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0
# Registry/tag of the application images (release deployments: ghcr.io/<org>/aquaguard, v1.2.3)
# AQUAGUARD_REGISTRY=aquaguard
# AQUAGUARD_TAG=local
